[TEMPLATE]
# ===== Portfolio contact form =====

# Where the form messages are sent
TO_EMAIL=jojiag2005@gmail.com

# --- SMTP ---
# NOTE: Render's FREE tier blocks outbound SMTP ports 25/465/587 (since Sep
# 2025). For a free Render deploy, use SendGrid SMTP on port 2525 instead:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=2525
#   SMTP_SECURE=false
#   SMTP_USER=apikey
#   SMTP_PASS=<SendGrid API key>   (free tier: 100 emails/day)
#
# Gmail (works locally / paid hosts) requires an "App Password":
#   Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=jojiag2005@gmail.com
SMTP_PASS=your-gmail-app-password-here

# Port for the local server (optional)
PORT=3000
