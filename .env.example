[TEMPLATE]
# ===== Portfolio contact form =====

# Where the form messages are sent
TO_EMAIL=jojiag2005@gmail.com

# --- Mail provider ---
# 'smtp' (default) or 'resend'.
# Resend is the reliable choice on Render's FREE tier, which blocks all
# outbound SMTP ports (25/465/587) since Sep 2025. Resend sends over HTTPS
# (port 443), which is never blocked. Free tier: 3,000 emails/month.
# Setup: resend.com -> sign up with jojiag2005@gmail.com -> API Keys.
# Without a custom domain, send from onboarding@resend.dev — it delivers
# to the account owner's email (your inbox), which suits this contact form.
#MAIL_PROVIDER=resend
#RESEND_API_KEY=re_your_resend_api_key
#MAIL_FROM="Portfolio Contact <onboarding@resend.dev>"

# --- SMTP (used when MAIL_PROVIDER=smtp) ---
# NOTE: Render's FREE tier blocks outbound SMTP ports 25/465/587 (since Sep
# 2025). For a free Render deploy, use SendGrid SMTP on port 2525 instead:
#   SMTP_HOST=smtp.sendgrid.net
#   SMTP_PORT=2525
#   SMTP_SECURE=false
#   SMTP_USER=apikey
#   SMTP_PASS=<SendGrid API key>   (free tier: 100 emails/day)
#
# Gmail (works locally / paid hosts) requires an "App Password":
#   Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=jojiag2005@gmail.com
SMTP_PASS=your-gmail-app-password-here

# Port for the local server (optional)
PORT=3000
